# syntax=docker/dockerfile:1

#===============================================================================
# DOWNLOADS
#===============================================================================

# The CI checkers that pyck-ai repositories run in `task ci` (ghalint,
# gitleaks, zizmor). Here rather than fetched per CI run: pyck-ai/github-runner
# builds on this image, so every runner job has them on PATH.
#
# ghalint checks GitHub Actions workflows (timeouts, permissions, pinned
# actions). A static Go binary, so one release archive serves Alpine and Debian.
FROM base AS ghalint
ARG TARGETPLATFORM TARGETARCH GHALINT_VERSION
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${GHALINT_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/suzuki-shunsuke/ghalint/releases/download/v{version}/ghalint_{version}_linux_{arch}.tar.gz"\
    --checksum-url "https://github.com/suzuki-shunsuke/ghalint/releases/download/v{version}/ghalint_{version}_checksums.txt"\
    --install-paths "ghalint"\
    --install-to "/usr/local/bin/"\
    --verify "ghalint --version | grep -qF 'version {version}'"

# gitleaks scans a repository and its history for committed secrets. Static
# Go binary, as above.
FROM base AS gitleaks
ARG TARGETPLATFORM TARGETARCH GITLEAKS_VERSION
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${GITLEAKS_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_linux_{arch}.tar.gz"\
    --checksum-url "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_checksums.txt"\
    --install-paths "gitleaks"\
    --install-to "/usr/local/bin/"\
    --verify "gitleaks version | grep -qF '{version}'"

#===============================================================================
# RESULT
#===============================================================================

FROM base
USER root

COPY --from=ghalint /usr/local/bin/ghalint /usr/local/bin/
COPY --from=gitleaks /usr/local/bin/gitleaks /usr/local/bin/

#===============================================================================
# GOLANG
#===============================================================================

ENV GOPATH=/go
ENV PATH="/usr/local/go/bin:/go/bin:${PATH}"
ENV GOCACHE=/var/cache/go/
ENV GOMODCACHE=/go/pkg/mod/
# Internal Go module proxy with fallback to direct. Mount GOCACHE and GOMODCACHE
# as volumes in CI to persist across builds.
ENV GOPROXY=https://go.pyck.cloud,direct
# All builds are statically linked by default; set CGO_ENABLED=1 explicitly if
# you need cgo.
ENV CGO_ENABLED=0

RUN install -d -o nonroot -g nonroot /go /go/bin /go/pkg/mod /var/cache/go
COPY --from=golang /usr/local/go /usr/local/go
COPY --from=golang\
     /usr/local/bin/dlv\
     /usr/local/bin/go-arch-lint\
     /usr/local/bin/golangci-lint\
     /usr/local/bin/gotestsum\
     /usr/local/bin/

#===============================================================================
# TYPESCRIPT (Bun)
#===============================================================================

ENV BUN_INSTALL=/bun
ENV PATH="/bun/bin:${PATH}"

RUN install -d -o nonroot -g nonroot /bun /bun/bin /bun/install /bun/install/global
COPY --from=typescript /usr/local/bin/bun /usr/local/bin/
RUN ln -s /usr/local/bin/bun /usr/local/bin/node
# bun's installer and official image create this link; bun runs as `bun x` when started as bunx
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

#===============================================================================
# AGENT (Claude Code, opencode, pi)
#===============================================================================

COPY --from=agent /usr/local/bin/claude /usr/local/bin/
COPY --from=agent /usr/local/bin/opencode /usr/local/bin/

# Alpine only: Claude's musl `posix_getdents` shim, loaded via LD_PRELOAD.
COPY --from=agent /usr/local/lib/claude_fix.so /usr/local/lib/
ENV LD_PRELOAD=/usr/local/lib/claude_fix.so

# we cant copy pi from the agent image because it would conflict with the bun installation of the typescript image above...
# Installed as nonroot so the global install stays writable at runtime; the
# symlink into /usr/local/bin needs root again.
ARG PI_VERSION
USER nonroot
RUN bun add -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" &&\
    pi --version | grep -qF "${PI_VERSION}"

USER root
RUN ln -s /bun/bin/pi /usr/local/bin/

#===============================================================================
# PYTHON (uv + Ruff)
#===============================================================================

ARG PYTHON_VERSION

# uv installs a musl python-build-standalone CPython, so this works on Alpine.
# uv/uvx/ruff are copied as binaries; the python/pip/pydoc entries are RECREATED
# as symlinks into the managed install rather than COPY'd, because `COPY --from`
# dereferences the source symlinks into standalone binaries at /usr/local/bin,
# which breaks python-build-standalone's stdlib (sys.prefix) resolution.
ENV UV_PYTHON_INSTALL_DIR=/usr/local/python
ENV UV_PYTHON_PREFERENCE=only-managed
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
RUN install -d -o nonroot -g nonroot /usr/local/python
COPY --from=python /usr/local/python /usr/local/python
COPY --from=python /usr/local/bin/uv /usr/local/bin/ruff /usr/local/bin/
RUN ln -sf uv /usr/local/bin/uvx &&\
    python_bin="$(uv python find ${PYTHON_VERSION})" &&\
    python_dir="${python_bin%/*}" &&\
    ln -sf "${python_dir}/python${PYTHON_VERSION}" /usr/local/bin/python${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/python${PYTHON_VERSION} /usr/local/bin/python3 &&\
    ln -sf /usr/local/bin/python3 /usr/local/bin/python &&\
    ln -sf "${python_dir}/pip${PYTHON_VERSION}" /usr/local/bin/pip${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/pip${PYTHON_VERSION} /usr/local/bin/pip3 &&\
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip &&\
    ln -sf "${python_dir}/pydoc${PYTHON_VERSION}" /usr/local/bin/pydoc${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/pydoc${PYTHON_VERSION} /usr/local/bin/pydoc3 &&\
    ln -sf /usr/local/bin/pydoc3 /usr/local/bin/pydoc

WORKDIR /app
