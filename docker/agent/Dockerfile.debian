# syntax=docker/dockerfile:1

FROM debian

ARG TARGETPLATFORM
ARG TARGETARCH
ARG CLAUDE_VERSION
ARG OPENCODE_VERSION
ARG BUN_VERSION
ARG PI_VERSION

USER 0

RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${CLAUDE_VERSION}"\
    --var "bucket=claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://storage.googleapis.com/{bucket}/claude-code-releases/{version}/linux-{arch}/claude"\
    --checksum-url "https://storage.googleapis.com/{bucket}/claude-code-releases/{version}/manifest.json"\
    --checksum-jq '.platforms["linux-{arch}"] | (.checksum + " " + .binary)'\
    --install-to "/usr/local/bin/"\
    --verify 'claude --version | grep -qF "{version}"'

# opencode checksums come from the GitHub releases-by-tag API: each asset carries
# a `digest` ("sha256:...") field, which --checksum-jq rewrites into a
# "<sha256>  <name>" line so the standard verification path is unchanged.
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${OPENCODE_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/anomalyco/opencode/releases/download/v{version}/opencode-linux-{arch}.tar.gz"\
    --checksum-url "https://api.github.com/repos/anomalyco/opencode/releases/tags/v{version}"\
    --checksum-jq '.assets[] | select(.name == "opencode-linux-{arch}.tar.gz") | (.digest | sub("sha256:"; "")) + "  " + .name'\
    --install-paths "opencode"\
    --install-to "/usr/local/bin/"\
    --verify 'opencode --version | grep -qF "{version}"'

# Bun runtime, required by the pi coding agent installed below. Uses the glibc
# build, mirroring the typescript image. `bun add -g` links pi's binary into
# /bun/bin, which is placed on PATH.
ENV BUN_INSTALL=/bun
ENV PATH="/bun/bin:${PATH}"
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${BUN_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/bun-linux-{arch}.zip"\
    --checksum-url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/SHASUMS256.txt"\
    --install-paths "bun-linux-{arch}/bun"\
    --install-to "/usr/local/bin/"\
    --verify "bun --version | grep -qF '{version}'"

# pi's binary is a `#!/usr/bin/env node` script. Bun runs in Node-compatibility
# mode when invoked as `node`, so a node->bun symlink lets pi run without a
# separate Node.js runtime. --ignore-scripts is safe: pi has no postinstall.
RUN ln -s /usr/local/bin/bun /usr/local/bin/node
RUN mkdir -p /bun/bin &&\
    bun add -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" &&\
    pi --version | grep -qF "${PI_VERSION}"

USER nonroot
WORKDIR /app
