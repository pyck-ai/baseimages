# syntax=docker/dockerfile:1

#===============================================================================
# DOWNLOADS
#===============================================================================

FROM base AS bun
ARG TARGETPLATFORM TARGETARCH BUN_VERSION PI_VERSION

ENV BUN_INSTALL=/bun
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${BUN_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/bun-linux-{arch}-musl.zip"\
    --checksum-url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/SHASUMS256.txt"\
    --install-paths "bun-linux-{arch}-musl/bun"\
    --install-to "/usr/local/bin/"\
    --verify "bun --version | grep -qF '{version}'" &&\
    ln -s /usr/local/bin/bun /usr/local/bin/node

RUN bun add -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" &&\
    ln -s /bun/bin/pi /usr/local/bin/ &&\
    pi --version | grep -qF "${PI_VERSION}"

FROM base AS claude
ARG TARGETPLATFORM TARGETARCH CLAUDE_VERSION

# The official Claude binaries are not compatible with alpine due to a missing symbol,
# so we provide a shim for it.
COPY <<EOF /tmp/claude_fix.c
#define _GNU_SOURCE
#include <dirent.h>
#include <sys/syscall.h>
#include <unistd.h>

ssize_t posix_getdents(int fd, void *buf, size_t count, int flags) {
    (void)flags;
    return syscall(SYS_getdents64, fd, buf, count);
}
EOF
RUN gcc -shared -fPIC -o /usr/local/lib/claude_fix.so /tmp/claude_fix.c &&\
    rm /tmp/claude_fix.c

RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${CLAUDE_VERSION}"\
    --var "bucket=claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://storage.googleapis.com/{bucket}/claude-code-releases/{version}/linux-{arch}-musl/claude"\
    --checksum-url "https://storage.googleapis.com/{bucket}/claude-code-releases/{version}/manifest.json"\
    --checksum-jq '.platforms["linux-{arch}-musl"] | (.checksum + " " + .binary)'\
    --install-to "/usr/local/bin/"\
    --verify 'claude --version | grep -qF "{version}"'


FROM base AS opencode
ARG TARGETPLATFORM TARGETARCH OPENCODE_VERSION

# opencode ships a native musl build, so it needs no compatibility shim. Checksums
# come from the GitHub releases-by-tag API: each asset carries a `digest`
# ("sha256:...") field, which --checksum-jq rewrites into a "<sha256>  <name>"
# line so the standard verification path is unchanged.
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${OPENCODE_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/anomalyco/opencode/releases/download/v{version}/opencode-linux-{arch}-musl.tar.gz"\
    --checksum-url "https://api.github.com/repos/anomalyco/opencode/releases/tags/v{version}"\
    --checksum-jq '.assets[] | select(.name == "opencode-linux-{arch}-musl.tar.gz") | (.digest | sub("sha256:"; "")) + "  " + .name'\
    --install-paths "opencode"\
    --install-to "/usr/local/bin/"\
    --verify 'opencode --version | grep -qF "{version}"'


#===============================================================================
# RESULT
#===============================================================================

FROM base
USER root

ENV BUN_INSTALL=/bun
ENV PATH="/bun/bin:${PATH}"
COPY --from=bun /usr/local/bin/bun /usr/local/bin/
COPY --from=bun --chown=nonroot:nonroot /bun/install/global /bun/install/global
COPY --from=bun --chown=nonroot:nonroot /bun/bin /bun/bin
RUN ln -s /usr/local/bin/bun /usr/local/bin/node

COPY --from=claude /usr/local/bin/claude /usr/local/bin/
COPY --from=claude /usr/local/lib/claude_fix.so /usr/local/lib/
ENV LD_PRELOAD=/usr/local/lib/claude_fix.so

COPY --from=opencode /usr/local/bin/opencode /usr/local/bin/

WORKDIR /app
