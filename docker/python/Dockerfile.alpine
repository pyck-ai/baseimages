# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3

#===============================================================================
# DOWNLOADS
#===============================================================================

FROM base AS uv
ARG TARGETPLATFORM TARGETARCH UV_VERSION
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${UV_VERSION}"\
    --platform-arch "linux/amd64=x86_64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/astral-sh/uv/releases/download/{version}/uv-{arch}-unknown-linux-musl.tar.gz"\
    --checksum-url "https://github.com/astral-sh/uv/releases/download/{version}/uv-{arch}-unknown-linux-musl.tar.gz.sha256"\
    --install-paths "uv-{arch}-unknown-linux-musl/uv"\
    --install-to "/usr/local/bin/"\
    --verify "uv --version | grep -qF '{version}'"

FROM base AS ruff
ARG TARGETPLATFORM TARGETARCH RUFF_VERSION
RUN --mount=type=cache,id=downloads,target=/var/cache/downloads,sharing=shared\
    download.sh\
    --var "version=${RUFF_VERSION}"\
    --platform-arch "linux/amd64=x86_64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/astral-sh/ruff/releases/download/{version}/ruff-{arch}-unknown-linux-musl.tar.gz"\
    --checksum-url "https://github.com/astral-sh/ruff/releases/download/{version}/ruff-{arch}-unknown-linux-musl.tar.gz.sha256"\
    --install-paths "ruff-{arch}-unknown-linux-musl/ruff"\
    --install-to "/usr/local/bin/"\
    --verify "ruff --version | grep -qF '{version}'"

#===============================================================================
# RESULT
#===============================================================================

FROM base
USER root

ENV UV_PYTHON_INSTALL_DIR=/usr/local/python
ENV UV_PYTHON_PREFERENCE=only-managed
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY --from=uv /usr/local/bin/uv /usr/local/bin/
RUN ln -s uv /usr/local/bin/uvx

ARG PYTHON_VERSION
RUN install -d -o nonroot -g nonroot /usr/local/python
RUN --mount=type=cache,id=uv-python,target=/var/cache/uv,sharing=shared\
    UV_CACHE_DIR=/var/cache/uv uv python install ${PYTHON_VERSION} &&\
    python_bin="$(uv python find ${PYTHON_VERSION})" &&\
    python_dir="${python_bin%/*}" &&\
    ln -sf "${python_dir}/python${PYTHON_VERSION}" /usr/local/bin/python${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/python${PYTHON_VERSION} /usr/local/bin/python3 &&\
    ln -sf /usr/local/bin/python3 /usr/local/bin/python &&\
    ln -sf "${python_dir}/pip${PYTHON_VERSION}" /usr/local/bin/pip${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/pip${PYTHON_VERSION} /usr/local/bin/pip3 &&\
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip &&\
    ln -sf "${python_dir}/pydoc${PYTHON_VERSION}" /usr/local/bin/pydoc${PYTHON_VERSION} &&\
    ln -sf /usr/local/bin/pydoc${PYTHON_VERSION} /usr/local/bin/pydoc3 &&\
    ln -sf /usr/local/bin/pydoc3 /usr/local/bin/pydoc

COPY --from=ruff /usr/local/bin/ruff /usr/local/bin/

WORKDIR /app
