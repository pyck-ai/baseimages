#######################################################################
#   CONFIGURATION                           #
#######################################################################

ARG ALPINE_VERSION=3.22
ARG ALPINE_MIRRORS=https://mirror.netcologne.de/alpine,https://mirror.leaseweb.com/alpine
ARG ALPINE_REPOS=main,community

ARG GO_VERSION=1.25.0

#######################################################################
#   END OF CONFIGURATION                        #
#                                   #
# Do not edit below this line unless you know what you are doing!   #
#######################################################################

FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION}
ARG TARGETPLATFORM

# Set up Golang
ENV GOCACHE=/var/cache/go/
ENV GOMODCACHE=/go/pkg/mod/
ENV GOPROXY=https://go.pyck.cloud,direct
ENV CGO_ENABLED=0

# Set up Alpine Linux repositories
ARG ALPINE_VERSION
ARG ALPINE_MIRRORS
ARG ALPINE_REPOS
RUN <<EOF
    echo "${ALPINE_MIRRORS}"\
    | tr ',' '\n'\
    | awk -v repos="${ALPINE_REPOS}" -v version="${ALPINE_VERSION}" '
    BEGIN { split(repos, repo_array, ","); }
    { for (i in repo_array) { print $0 "/v" version "/" repo_array[i]; } }' > /etc/apk/repositories
EOF

# Install shared dependencies
RUN --mount=type=cache,id=apk-cache,target=/var/cache/apk/\
    apk add --update --no-progress\
    aws-cli\
    bash\
    build-base\
    coreutils\
    curl\
    gawk\
    gcc\
    gcompat\
    gettext-envsubst\
    git\
    jq\
    libgcc\
    libstdc++\
    linux-headers\
    musl\
    musl-dev\
    ripgrep\
    rsync\
    unzip\
    zstd

ONBUILD RUN --mount=type=cache,id=apk-cache,target=/var/cache/apk/\
    apk add --update --no-progress\
    ca-certificates &&\
    update-ca-certificates

# Install download.sh helper script
COPY download.sh /download.sh

# Install bun
ARG BUN_VERSION
RUN /download.sh\
    --var "version=${BUN_VERSION}"\
    --platform-arch "linux/amd64=x64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/bun-{os}-{arch}-musl.zip"\
    --checksum-url "https://github.com/oven-sh/bun/releases/download/bun-v{version}/SHASUMS256.txt"\
    --install-paths "bun-linux-{arch}-musl/bun"\
    --install-to "/usr/local/bin/"\
    --verify "bun --version | grep -qF '{version}'"
ENV PATH="/root/.bun/bin:$PATH"

# Install delve
ARG DELVE_VERSION
RUN /download.sh\
    --var "version=${DELVE_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/go-delve/delve/releases/download/v{version}/dlv_{version}_{os}_{arch}.tar.gz"\
    --checksum-url "https://github.com/go-delve/delve/releases/download/v{version}/checksums.txt"\
    --install-paths "dlv"\
    --install-to "/usr/local/bin/"\
    --verify "dlv version | grep -qF 'Version: {version}'"

# Install flyctl (Fly.io CLI)
ARG FLYCTL_VERSION
RUN /download.sh\
    --var "version=${FLYCTL_VERSION}"\
    --platform-arch "linux/amd64=x86_64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/superfly/flyctl/releases/download/v{version}/flyctl_{version}_Linux_{arch}.tar.gz"\
    --checksum-url "https://github.com/superfly/flyctl/releases/download/v{version}/flyctl_{version}_checksums.txt"\
    --install-paths "flyctl"\
    --install-to "/usr/local/bin/"\
    --verify "flyctl --version | grep -qF 'version {version}'"

# Install GitHub CLI
ARG GITHUBCLI_VERSION
RUN /download.sh\
    --var "version=${GITHUBCLI_VERSION}"\
    --url "https://github.com/cli/cli/releases/download/v{version}/gh_{version}_{os}_{arch}.tar.gz"\
    --checksum-url "https://github.com/cli/cli/releases/download/v{version}/gh_{version}_checksums.txt"\
    --install-paths "gh_{version}_{os}_{arch}/bin/gh"\
    --install-to "/usr/local/bin/"\
    --verify "gh --version | grep -qF 'version {version}'"

# Install go-arch-lint
ARG GOARCHLINT_VERSION
RUN /download.sh\
    --var "version=${GOARCHLINT_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/fe3dback/go-arch-lint/releases/download/v{version}/go-arch-lint_{version}_{os}_{arch}.tar.gz"\
    --checksum-url "https://github.com/fe3dback/go-arch-lint/releases/download/v{version}/checksums.txt"\
    --install-paths "go-arch-lint"\
    --install-to "/usr/local/bin/"\
    --verify "go-arch-lint version --output-color=false | grep -qF 'version: {version}'"

# Install golangci-lint
ARG GOLANGCILINT_VERSION
RUN /download.sh\
    --var "version=${GOLANGCILINT_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/golangci/golangci-lint/releases/download/v{version}/golangci-lint-{version}-{os}-{arch}.tar.gz"\
    --checksum-url "https://github.com/golangci/golangci-lint/releases/download/v{version}/golangci-lint-{version}-checksums.txt"\
    --install-paths "golangci-lint-{version}-{os}-{arch}/golangci-lint"\
    --install-to "/usr/local/bin/"\
    --verify "golangci-lint --version | grep -qF 'version {version}'"

# Install gotestsum
ARG GOTESTSUM_VERSION
RUN /download.sh\
    --var "version=${GOTESTSUM_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/gotestyourself/gotestsum/releases/download/v{version}/gotestsum_{version}_linux_{arch}.tar.gz"\
    --checksum-url "https://github.com/gotestyourself/gotestsum/releases/download/v{version}/gotestsum-{version}-checksums.txt"\
    --install-paths "gotestsum"\
    --install-to "/usr/local/bin/"\
    --verify "gotestsum --version | grep -qF 'version v{version}'"

# Install Helm
ARG HELM_VERSION
RUN /download.sh\
    --var "version=${HELM_VERSION}"\
    --url "https://get.helm.sh/helm-v{version}-{os}-{arch}.tar.gz"\
    --checksum-url "https://get.helm.sh/helm-v{version}-{os}-{arch}.tar.gz.sha256sum"\
    --install-paths "{os}-{arch}/helm"\
    --install-to "/usr/local/bin/"\
    --verify "helm version | grep -qF 'Version:\"v{version}\"'"

# Install kubectl
ARG KUBECTL_VERSION
RUN /download.sh\
    --var "version=${KUBECTL_VERSION}"\
    --url "https://dl.k8s.io/release/v{version}/bin/{os}/{arch}/kubectl"\
    --checksum-url "https://dl.k8s.io/release/v{version}/bin/{os}/{arch}/kubectl.sha256"\
    --install-to "/usr/local/bin/"\
    --verify "kubectl version --client=true | grep -qF 'Client Version: v{version}'"

# Install Kustomize
ARG KUSTOMIZE_VERSION
RUN /download.sh\
    --var "version=${KUSTOMIZE_VERSION}"\
    --url "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv{version}/kustomize_v{version}_{os}_{arch}.tar.gz"\
    --checksum-url "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv{version}/checksums.txt"\
    --install-paths "kustomize"\
    --install-to "/usr/local/bin/"\
    --verify "kustomize version | grep -qF 'v{version}'"

# Install rover
#
# NOTE: Rover releases do not contain builds for aarch64-musl, so this is currently disabled.
#
# ARG ROVER_VERSION
# RUN /download.sh\
#     --var "version=${ROVER_VERSION}"\
#     --platform-arch "linux/amd64=x86_64"\
#     --platform-arch "linux/arm64=aarch64"\
#     --url "https://github.com/apollographql/rover/releases/download/v{version}/rover-v{version}-{arch}-unknown-{os}-musl.tar.gz"\
#     --checksum-url "https://github.com/apollographql/rover/releases/download/v{version}/sha256sums.txt"\
#     --install-paths "dist/rover"\
#     --install-to "/usr/local/bin/"\
#     --verbose

# Install taskfile
ARG TASKFILE_VERSION
RUN /download.sh\
    --var "version=${TASKFILE_VERSION}"\
    --platform-arch "linux/amd64=amd64"\
    --platform-arch "linux/arm64=arm64"\
    --url "https://github.com/go-task/task/releases/download/v{version}/task_{os}_{arch}.tar.gz"\
    --checksum-url "https://github.com/go-task/task/releases/download/v{version}/task_checksums.txt"\
    --install-paths "task"\
    --install-to "/usr/local/bin/"\
    --verify "task --version | grep -qF '{version}'"

# Install watchexec
ARG WATCHEXEC_VERSION
RUN /download.sh\
    --var "version=${WATCHEXEC_VERSION}"\
    --platform-arch "linux/amd64=x86_64"\
    --platform-arch "linux/arm64=aarch64"\
    --url "https://github.com/watchexec/watchexec/releases/download/v{version}/watchexec-{version}-{arch}-unknown-{os}-musl.tar.xz"\
    --checksum-url "https://github.com/watchexec/watchexec/releases/download/v{version}/watchexec-{version}-{arch}-unknown-{os}-musl.tar.xz.sha256"\
    --install-paths "watchexec-{version}-{arch}-unknown-{os}-musl/watchexec"\
    --install-to "/usr/local/bin/"\
    --verify "watchexec --version | grep -qF 'watchexec {version}'"
