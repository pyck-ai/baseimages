#######################################################################
#   CONFIGURATION                                                     #
#######################################################################

ARG FLUTTER_VERSION=3.38.1

#######################################################################
#   END OF CONFIGURATION                                              #
#                                                                     #
# Do not edit below this line unless you know what you are doing!     #
#######################################################################

FROM ghcr.io/pyck-ai/baseimages/debian:latest
ARG TARGETPLATFORM
ARG TARGETARCH

# Install Flutter dependencies
RUN --mount=type=cache,id=apt-cache,target=/var/cache/apt/,sharing=locked \
    --mount=type=cache,id=apt-listscache,target=/var/lib/apt/lists/,sharing=locked \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        file \
        libgcc-s1 \
        libglu1-mesa \
        libstdc++6 \
        unzip \
        xz-utils \
        zip

# Create flutter user and set up directories
RUN useradd -m -s /bin/bash -u 1000 flutter && \
    mkdir -p /opt/flutter /app && \
    chown -R flutter:flutter /opt/flutter /app

# Switch to flutter user
USER flutter

# Download and install Flutter SDK
ARG FLUTTER_VERSION
COPY --chown=flutter:flutter --chmod=755 flutter/install-flutter.sh /tmp/install-flutter.sh
RUN /tmp/install-flutter.sh

# Add Flutter to PATH
ENV PATH="/opt/flutter/bin:$PATH"

# Replace bundled Dart SDK with ARM64 version on ARM64 builds
# Flutter bundles x86-64 Dart SDK, but Dart provides official ARM64 Linux builds
ARG FLUTTER_VERSION
COPY --chown=flutter:flutter --chmod=755 flutter/replace-dart-sdk.sh /tmp/replace-dart-sdk.sh
RUN /tmp/replace-dart-sdk.sh

# Pre-download Flutter dependencies and validate installation
RUN flutter config --no-analytics && \
    flutter precache && \
    flutter doctor && \
    dart --disable-analytics

# Copy RFW validator tools
COPY --chown=flutter:flutter flutter/ /opt/rfw-validator/

# Install RFW validator dependencies
RUN cd /opt/rfw-validator && \
    dart pub get && \
    chmod +x entrypoint.sh validate_rfw.dart generate_binary.dart

# Set up entrypoint
ENTRYPOINT ["/opt/rfw-validator/entrypoint.sh"]
CMD ["validate-rfw"]

# Set working directory
WORKDIR /app
