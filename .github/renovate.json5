{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		// Renovate's recommended defaults: grouping, automerge, ignore patterns, etc.
		"config:recommended",
		// Shared org defaults (branchPrefix, timezone, automerge schedule/strategy,
		// minimumReleaseAge, labels, semanticCommits, vulnerability alerts, and the
		// shared packageRules).
		"local>pyck-ai/renovate//presets/default.json5",
		// Shared customManagers preset for the buildargs.conf inline-comment manager.
		"local>pyck-ai/renovate//presets/buildargs.json5"
	],
	// Only manage GitHub Actions pins and the custom regex manager for buildargs.conf.
	// CRITICAL: "custom.regex" must stay here even though the buildargs preset supplies
	// the manager itself, because "enabledManagers" is NOT mergeable (a repo's own value
	// replaces a preset's entirely). Without this entry the manager is silently inert.
	"enabledManagers": [
		"github-actions",
		"custom.regex"
	],
	"customDatasources": {
		// Fetches the latest Claude Code version from the official GCS distribution endpoint.
		// The endpoint returns a plain-text version string (e.g. "2.1.116"), one per line.
		"anthropic-claude": {
			"defaultRegistryUrlTemplate": "https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/latest",
			"format": "plain"
		}
	},
	// The shared packageRules from presets/default.json5 arrive first and are
	// prepended ahead of these; these repo-specific rules are appended after them,
	// so they still win where they overlap.
	"packageRules": [
		{
			// Batch all minor/patch updates into one PR to reduce noise.
			// nginx and golang base images are excluded below and get their own PRs.
			"description": "Group all minor and patch updates into one PR",
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "all minor and patch updates"
		},
		{
			// nginx releases lag behind golang Alpine tags, so keeping it separate prevents
			// a single blocked nginx update from holding up all other dependency bumps.
			"description": "Keep nginx separate (alpine releases lag behind golang)",
			"matchPackageNames": ["nginxinc/nginx-unprivileged"],
			"groupName": "nginx"
		},
		{
			// golang and delve are grouped together and kept separate from the general
			// batch. Delve embeds the Go version it was built against and must match the
			// toolchain, so the two are always bumped in lockstep when a new Go release ships.
			"description": "Keep golang and delve together, separate from the general batch",
			"matchPackageNames": ["golang", "go-delve/delve"],
			"matchManagers": ["custom.regex"],
			"groupName": "golang base images"
		},
		{
			// The anthropic-claude custom datasource is a plain-text endpoint with no
			// release timestamp, so it hits the same timestamp-required pending trap.
			"description": "Claude custom datasource has no release timestamp",
			"matchDepNames": ["claude"],
			"minimumReleaseAgeBehaviour": "timestamp-optional"
		}
	]
}
